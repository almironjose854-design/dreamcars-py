{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamcars-py",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://dreamcars-py.almironjose854.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dreamcars-py-data"
    }
  ]
}
