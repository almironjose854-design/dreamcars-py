# Opcional: para configurar Cloudinary desde variables del servidor.
# El panel permite conectarlo sin editar estos valores.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Claves privadas generadas localmente en .dev.vars; no publicar sus valores.
ADMIN_AUTH_SECRET=
ADMIN_BOOTSTRAP_ACCOUNT=
INTEGRATION_ENCRYPTION_KEY=
# Almacenamiento persistente S3 compatible para Render (por ejemplo, R2).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_SITE_URL=https://dreamcars-py.onrender.com
